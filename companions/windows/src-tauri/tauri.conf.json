{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeekPet",
  "version": "0.1.0",
  "identifier": "com.deepseek.pet",
  "build": {
    "frontendDist": "../../../companion/Resources/pet"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Pet",
        "width": 380,
        "height": 560,
        "minWidth": 118,
        "minHeight": 118,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["../../../companion/Resources/pet/icon.png"]
  }
}
